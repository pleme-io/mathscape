        "wall"
      ],
      "type": "string"
    },
    "StreamConfig": {
      "additionalProperties": false,
      "properties": {
        "adaptive_every": {
          "default": 1,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "checkpoint_epochs": {
          "default": 64,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
