        },
        "interval": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "NetworkPolicy": {
      "additionalProperties": false,
      "properties": {
        "additionalEgress": {
          "items": true,
          "type": "array"
        },
        "additionalIngress": {
          "items": true,
          "type": "array"
        },
        "allowDns": {
          "type": "boolean"
        },
        "allowPrometheus": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Pdb": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Persistence": {
      "additionalProperties": false,
      "properties": {
        "accessModes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "mountPath": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Protocol": {
      "enum": [
        "TCP",
        "UDP",
        "SCTP"
      ],
      "type": "string"
    },
    "PullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ],
      "type": "string"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "ports": {
          "items": {
            "$ref": "#/definitions/ServicePort"
          },
          "type": "array"
        },
        "type": {
          "$ref": "#/definitions/ServiceType"
        }
      },
      "type": "object"
    },
    "ServiceAccount": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ServicePort": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "port": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0.0,
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/definitions/Protocol"
        },
        "targetPort": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "port"
      ],
      "type": "object"
    },
    "ServiceType": {
      "enum": [
        "ClusterIP",
        "NodePort",
        "LoadBalancer"
      ],
      "type": "string"
    },
    "StartupProbe": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "failureThreshold": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "initialDelaySeconds": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "periodSeconds": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
