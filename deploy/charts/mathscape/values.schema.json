        "certify_exhaustive": {
          "default": 4096,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "certify_pool": {
          "default": 7,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "certify_samples": {
          "default": 64,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "definable_filter": {
          "default": true,
          "type": "boolean"
        },
        "fingerprint_pool": {
          "default": 5,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "fingerprint_samples": {
          "default": 16,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "fuel": {
          "default": 20000,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "generative": {
          "default": true,
          "type": "boolean"
        },
        "law_max_size": {
          "default": 5,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "law_universe_max": {
          "default": 20000,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "law_vars": {
          "default": 3,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0.0,
          "type": "integer"
        },
        "library_atoms": {
          "default": false,
          "type": "boolean"
        },
        "max_constants": {
          "default": 2,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_depth": {
          "default": 1024,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_laws_per_name": {
          "default": 16,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_nodes": {
          "default": 4096,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_term_size": {
          "default": 24,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "min_image_binary": {
          "default": 4,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "min_image_unary": {
          "default": 6,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "min_laws": {
          "default": 2,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "names_per_epoch": {
          "default": 1,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "terms_per_epoch": {
          "default": 20000,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Extractor": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "derived-laws"
              ],
              "type": "string"
            },
            "min_support": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "step_limit": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "min_support",
            "step_limit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "k_samples": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "kind": {
              "enum": [
                "validated"
              ],
              "type": "string"
            },
            "min_support": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "seed": {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "step_limit": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "subterm_depth": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "k_samples",
            "kind",
            "min_support",
            "seed",
            "step_limit",
            "subterm_depth"
          ],
          "type": "object"
        }
      ]
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "livenessFailureThreshold": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "livenessInitialDelay": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "livenessPeriod": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "readinessFailureThreshold": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "readinessInitialDelay": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "readinessPeriod": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "readyPath": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "properties": {
        "pullPolicy": {
          "$ref": "#/definitions/PullPolicy"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
