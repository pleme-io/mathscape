        "port": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "StorageKind": {
      "enum": [
        "claimTemplate",
        "hostPath"
      ],
      "type": "string"
    },
    "Stream": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "properties": {
        "alerts": {
          "$ref": "#/definitions/StreamAlerts"
        },
        "breathe": {
          "additionalProperties": true,
          "type": "object"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "config": {
          "$ref": "#/definitions/StreamConfig"
        },
        "dataDir": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "health": {
          "$ref": "#/definitions/StreamHealth"
        },
        "image": {
          "$ref": "#/definitions/StreamImage"
        },
        "nodeSelector": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "resources": {
          "additionalProperties": true,
          "type": "object"
        },
        "rustLog": {
          "type": "string"
        },
        "scrape": {
          "$ref": "#/definitions/StreamScrape"
        },
        "seed": {
          "description": "Non-negative integer, as a string; required when stream.enabled",
          "pattern": "^([0-9]+)?$",
          "type": "string"
        },
        "storage": {
          "$ref": "#/definitions/StreamStorage"
        },
        "terminationGracePeriodSeconds": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "untilEpoch": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "pattern": "^([0-9]+)?$",
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "seed",
        "untilEpoch"
      ],
      "then": {
        "properties": {
          "seed": {
            "minLength": 1
          }
        },
        "required": [
          "seed"
        ]
      },
      "type": "object"
    },
    "StreamAlerts": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "plateauHours": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "snapshotStaleMinutes": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        },
        "stalledMinutes": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
