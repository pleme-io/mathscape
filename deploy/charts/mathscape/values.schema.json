          "default": {
            "basis": "lambda",
            "certify_exhaustive": 4096,
            "certify_pool": 7,
            "certify_samples": 64,
            "definable_filter": true,
            "fingerprint_pool": 5,
            "fingerprint_samples": 16,
            "fuel": 20000,
            "generative": true,
            "law_max_size": 5,
            "law_universe_max": 20000,
            "law_vars": 3,
            "library_atoms": false,
            "max_constants": 2,
            "max_depth": 1024,
            "max_laws_per_name": 16,
            "max_nodes": 4096,
            "max_term_size": 24,
            "min_image_binary": 4,
            "min_image_unary": 6,
            "min_laws": 2,
            "names_per_epoch": 1,
            "terms_per_epoch": 20000
          }
        },
        "extractor": {
          "allOf": [
            {
              "$ref": "#/definitions/Extractor"
            }
          ],
          "default": {
            "kind": "derived-laws",
            "min_support": 2,
            "step_limit": 300
          }
        },
        "frontier": {
          "allOf": [
            {
              "$ref": "#/definitions/StreamFrontier"
            }
          ],
          "default": {
            "enabled": false,
            "per_epoch": 64,
            "variables": 3
          }
        },
        "iterations": {
          "default": 5,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "learning_rate": {
          "default": 0.1,
          "format": "double",
          "type": "number"
        },
        "mechanism": {
          "allOf": [
            {
              "$ref": "#/definitions/StreamMechanism"
            }
          ],
          "default": {
            "drive_motor": true,
            "escalation_budget": 2,
            "graveyard": "context",
            "mutations_per_round": 6,
            "plateau_epochs": 4,
            "respond": true,
            "trial_budget": 256,
            "trial_ceiling": 32768,
            "trial_scale": "opened",
            "trial_stop_after": 1
          }
        },
        "novelty": {
          "allOf": [
            {
              "$ref": "#/definitions/StreamNovelty"
            }
          ],
          "default": "entailment"
        },
        "phases_per_epoch": {
          "default": 2,
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "snapshot_every": {
          "default": 4,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "substrate": {
          "allOf": [
            {
              "$ref": "#/definitions/StreamSubstrate"
            }
          ],
          "default": "emergent"
        }
      },
      "type": "object"
