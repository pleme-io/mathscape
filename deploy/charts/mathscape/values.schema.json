  "additionalProperties": false,
  "definitions": {
    "Basis": {
      "enum": [
        "lambda",
        "combinators"
      ],
      "type": "string"
    },
    "ContainerPort": {
      "additionalProperties": false,
      "properties": {
        "containerPort": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/definitions/Protocol"
        }
      },
      "required": [
        "containerPort",
        "name"
      ],
      "type": "object"
    },
    "EmergenceConfig": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "allOf": [
